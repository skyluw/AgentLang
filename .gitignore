# Bytecode compilado de Java (nunca debe versionarse)
*.class

# Archivos auxiliares generados por ANTLR (se regeneran desde AgentLang.g4)
*.interp
*.tokens

# IDE / sistema operativo
.idea/
.vscode/
.DS_Store

